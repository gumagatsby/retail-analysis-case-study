pt, go to DuckDB as Parquet.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-2-legend"><mxGeometry x="52" y="0" width="548" height="58" as="geometry" /></mxCell><mxCell id="step-3-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="124" width="600" height="58" as="geometry" /></mxCell><mxCell id="step-3-badge-legend" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-3-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell><mxCell id="step-3-desc-legend" value="&lt;div&gt;&lt;b&gt;Test&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;pytest checks every cleaning rule; the categories add back up to all 1,067,371 rows.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-3-legend"><mxGeometry x="52" y="0" width="548" height="58" as="geometry" /></mxCell><mxCell id="step-4-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="186" width="600" height="58" as="geometry" /></mxCell><mxCell id="step-4-badge-legend" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-4-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell><mxCell id="step-4-desc-legend" value="&lt;div&gt;&lt;b&gt;Analyse&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;SQL feeds the statistics: cohorts, segments, the overseas test, the forecast, product pairs.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-4-legend"><mxGeometry x="52" y="0" width="548" height="58" as="geometry" /></mxCell><mxCell id="step-5-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="248" width="600" height="58" as="geometry" /></mxCell><mxCell id="step-5-badge-legend" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-5-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell><mxCell id="step-5-desc-legend" value="&lt;div&gt;&lt;b&gt;Export&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;analysis/run.py writes metrics.json, the charts and the Power BI data files.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-5-legend"><mxGeometry x="52" y="0" width="548" height="58" as="geometry" /></mxCell><mxCell id="step-6-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="310" width="600" height="58" as="geometry" /></mxCell><mxCell id="step-6-badge-legend" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-6-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell><mxCell id="step-6-desc-legend" value="&lt;div&gt;&lt;b&gt;Report as code&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;build_pbip.py writes the TMDL model and PBIR pages; validate.py checks them against Microsoft's schemas.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-6-legend"><mxGeometry x="52" y="0" width="548" height="58" as="geometry" /></mxCell><mxCell id="step-7-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="372" width="600" height="58" as="geometry" /></mxCell><mxCell id="step-7-badge-legend" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-7-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell><mxCell id="step-7-desc-legend" value="&lt;div&gt;&lt;b&gt;Upload and fetch&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;powerbi_vm.sh up creates the machine and copies the project and data to S3; fetch copies the .pbix and PDF back.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-7-legend"><mxGeometry x="52" y="0" width="548" height="58" as="geometry" /></mxCell><mxCell id="step-8-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="434" width="600" height="58" as="geometry" /></mxCell><mxCell id="step-8-badge-legend" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-8-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell><mxCell id="step-8-desc-legend" value="&lt;div&gt;&lt;b&gt;Command&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Systems Manager Run Command installs Power BI Desktop and runs each PowerShell step.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-8-legend"><mxGeometry x="52" y="0" width="548" height="58" as="geometry" /></mxCell><mxCell id="step-9-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="496" width="600" height="58" as="geometry" /></mxCell><mxCell id="step-9-badge-legend" value="9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-9-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell><mxCell id="step-9-desc-legend" value="&lt;div&gt;&lt;b&gt;Build&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;UI Automation opens the report, refreshes it, saves the .pbix and exports the PDF.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-9-legend"><mxGeometry x="52" y="0" width="548" height="58" as="geometry" /></mxCell><mxCell id="step-10-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="558" width="600" height="58" as="geometry" /></mxCell><mxCell id="step-10-badge-legend" value="10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-10-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell><mxCell id="step-10-desc-legend" value="&lt;div&gt;&lt;b&gt;Transfer&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The machine reads the project and data from S3 and writes the .pbix and PDF back.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-10-legend"><mxGeometry x="52" y="0" width="548" height="58" as="geometry" /></mxCell><mxCell id="step-11-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="620" width="600" height="58" as="geometry" /></mxCell><mxCell id="step-11-badge-legend" value="11" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-11-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell><mxCell id="step-11-desc-legend" value="&lt;div&gt;&lt;b&gt;Commit and delete&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The files are committed next to the code that made them; powerbi_vm.sh down deletes everything in AWS.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-11-legend"><mxGeometry x="52" y="0" width="548" height="58" as="geometry" /></mxCell><mxCell id="step-12-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="682" width="600" height="58" as="geometry" /></mxCell><mxCell id="step-12-badge-legend" value="12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-12-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell><mxCell id="step-12-desc-legend" value="&lt;div&gt;&lt;b&gt;Check&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;GitHub Actions re-runs the analysis and fails if any figure changes.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-12-legend"><mxGeometry x="52" y="0" width="548" height="58" as="geometry" /></mxCell><mxCell id="step-13-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="744" width="600" height="58" as="geometry" /></mxCell><mxCell id="step-13-badge-legend" value="13" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-13-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell><mxCell id="step-13-desc-legend" value="&lt;div&gt;&lt;b&gt;Read&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The owners read the write-up and the report.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-13-legend"><mxGeometry x="52" y="0" width="548" height="58" as="geometry" /></mxCell><mxCell id="legend-aux-note" value="&lt;i&gt;Auxiliary: the IAM role lets the machine use Systems Manager and this one bucket. Grey boxes hold third-party technology, shown with its own logo; the Power BI mark sits on the machine that runs Desktop.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;fontColor=light-dark(#333333,#D4D4D4);fontFamily=Helvetica;" vertex="1" parent="legend-container"><mxGeometry x="0" y="810" width="600" height="40" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>