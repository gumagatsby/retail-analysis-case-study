n=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="395" width="800" height="34" as="geometry"/></mxCell><mxCell id="s0-1" value="How many new customers order again" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="437" width="800" height="34" as="geometry"/></mxCell><mxCell id="s0-2" value="Who carries the business, and who has gone quiet" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="479" width="800" height="34" as="geometry"/></mxCell><mxCell id="s0-3" value="How seasonal the year is, and how to plan the next one" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="521" width="800" height="34" as="geometry"/></mxCell><mxCell id="s0-4" value="What sells together, and whether selling abroad pays" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="563" width="800" height="34" as="geometry"/></mxCell><mxCell id="s1-h" value="What two years of sales say" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=24;fontStyle=1;" vertex="1" parent="1" ><mxGeometry x="50" y="650" width="800" height="34" as="geometry"/></mxCell><mxCell id="s1-0" value="£19.3 million of sales; every one of 1,067,371 rows accounted for" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="700" width="800" height="34" as="geometry"/></mxCell><mxCell id="s1-1" value="A quarter of customers bring in 70% of the money" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="742" width="800" height="34" as="geometry"/></mxCell><mxCell id="s1-2" value="842 former regulars, worth £1.46 million, have gone quiet" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="784" width="800" height="34" as="geometry"/></mxCell><mxCell id="s1-3" value="Overseas customers&#x27; typical order is £119 bigger" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="826" width="800" height="34" as="geometry"/></mxCell><mxCell id="s1-4" value="Last year&#x27;s month forecasts within about 5 to 10%" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="868" width="800" height="34" as="geometry"/></mxCell><mxCell id="note" value="The Power BI report is built as code, rendered on a Windows machine in AWS, and the machine is deleted afterwards." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="955" width="800" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>