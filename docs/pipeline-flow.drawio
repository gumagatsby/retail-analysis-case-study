glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="240" width="28" height="28" as="geometry" /></mxCell><mxCell id="step-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1210" y="236" width="28" height="28" as="geometry" /></mxCell><mxCell id="step-7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1415" y="240" width="28" height="28" as="geometry" /></mxCell><mxCell id="step-8" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1620" y="240" width="28" height="28" as="geometry" /></mxCell><mxCell id="legend-bg" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1840" y="30" width="650" height="590" as="geometry" /></mxCell><mxCell id="legend-container" value="" style="group" vertex="1" parent="1" connectable="0"><mxGeometry x="1860" y="60" width="602" height="550" as="geometry" /></mxCell><mxCell id="step-1-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="0" width="600" height="58" as="geometry" /></mxCell><mxCell id="step-1-badge-legend" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-1-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell><mxCell id="step-1-desc-legend" value="&lt;div&gt;&lt;b&gt;Extract&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Download the workbook from UCI and check its checksum. Read both sheets as text, keep sheet and row number, write Parquet.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-1-legend"><mxGeometry x="52" y="0" width="548" height="58" as="geometry" /></mxCell><mxCell id="step-2-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="62" width="600" height="58" as="geometry" /></mxCell><mxCell id="step-2-badge-legend" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-2-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell><mxCell id="step-2-desc-legend" value="&lt;div&gt;&lt;b&gt;Stage&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Apply types, one row per Excel row, trim stock codes. Nothing is removed.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-2-legend"><mxGeometry x="52" y="0" width="548" height="58" as="geometry" /></mxCell><mxCell id="step-3-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="124" width="600" height="58" as="geometry" /></mxCell><mxCell id="step-3-badge-legend" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-3-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell><mxCell id="step-3-desc-legend" value="&lt;div&gt;&lt;b&gt;Classify&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Every row gets one of seven categories, with a reason: overlap, bad debt, non-product, cancellation, stock write-off, unpriced, sale.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-3-legend"><mxGeometry x="52" y="0" width="548" height="58" as="geometry" /></mxCell><mxCell id="step-4-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="186" width="600" height="58" as="geometry" /></mxCell><mxCell id="step-4-badge-legend" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-4-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell><mxCell id="step-4-desc-legend" value="&lt;div&gt;&lt;b&gt;Model&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Mark voided lines and price errors. Build the sales, returns and customers tables.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-4-legend"><mxGeometry x="52" y="0" width="548" height="58" as="geometry" /></mxCell><mxCell id="step-5-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="248" width="600" height="58" as="geometry" /></mxCell><mxCell id="step-5-badge-legend" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-5-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell><mxCell id="step-5-desc-legend" value="&lt;div&gt;&lt;b&gt;Test&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;pytest runs on the full dataset: the categories add back up to all 1,067,371 rows and each cleaning rule is checked.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-5-legend"><mxGeometry x="52" y="0" width="548" height="58" as="geometry" /></mxCell><mxCell id="step-6-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="310" width="600" height="58" as="geometry" /></mxCell><mxCell id="step-6-badge-legend" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-6-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell><mxCell id="step-6-desc-legend" value="&lt;div&gt;&lt;b&gt;Analyse&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Write metrics.json, the charts and the Power BI data files. Every query is ordered, so a re-run matches to the last digit.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-6-legend"><mxGeometry x="52" y="0" width="548" height="58" as="geometry" /></mxCell><mxCell id="step-7-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="372" width="600" height="58" as="geometry" /></mxCell><mxCell id="step-7-badge-legend" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-7-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell><mxCell id="step-7-desc-legend" value="&lt;div&gt;&lt;b&gt;CI check&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;GitHub Actions re-runs every step, compares each figure with the committed metrics.json, and regenerates the Power BI project to diff it.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-7-legend"><mxGeometry x="52" y="0" width="548" height="58" as="geometry" /></mxCell><mxCell id="step-8-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="434" width="600" height="58" as="geometry" /></mxCell><mxCell id="step-8-badge-legend" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-8-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell><mxCell id="step-8-desc-legend" value="&lt;div&gt;&lt;b&gt;Done&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Everything matches, so the write-up's figures are the ones the code produces.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-8-legend"><mxGeometry x="52" y="0" width="548" height="58" as="geometry" /></mxCell><mxCell id="legend-aux-note" value="&lt;i&gt;Red dashed lines are the failure paths. The workbook's checksum is checked on every run, so a changed file can't slip through.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;fontColor=light-dark(#333333,#D4D4D4);fontFamily=Helvetica;" vertex="1" parent="legend-container"><mxGeometry x="0" y="500" width="600" height="40" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>