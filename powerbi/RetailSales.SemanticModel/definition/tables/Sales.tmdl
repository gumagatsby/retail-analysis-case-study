table Sales

	measure Revenue = SUM(Sales[Line revenue])
		formatString: £#,0

	measure Orders = DISTINCTCOUNT(Sales[Invoice])
		formatString: #,0

	measure 'Customers with an account' = DISTINCTCOUNTNOBLANK(Sales[Customer ID])
		formatString: #,0

	measure 'Average order' = DIVIDE([Revenue], [Orders])
		formatString: £#,0.00

	measure 'Revenue, complete months' = IF(MAX(Sales[Month]) < DATE(2011, 12, 1), [Revenue])
		formatString: £#,0

	column Invoice
		dataType: string
		summarizeBy: none
		sourceColumn: invoice

	column Date
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: invoice_date

	column Month
		dataType: dateTime
		formatString: mmm yyyy
		summarizeBy: none
		sourceColumn: month

	column 'Stock code'
		dataType: string
		summarizeBy: none
		sourceColumn: stock_code

	column Product
		dataType: string
		summarizeBy: none
		sourceColumn: description

	column Quantity
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: quantity

	column 'Unit price'
		dataType: decimal
		formatString: £#,0.00
		summarizeBy: none
		sourceColumn: price

	column 'Line revenue'
		dataType: decimal
		formatString: £#,0.00
		summarizeBy: sum
		sourceColumn: revenue

	column 'Customer ID'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: customer_id

	column Country
		dataType: string
		summarizeBy: none
		sourceColumn: country

	partition Sales = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "sales.parquet")),
				    Typed = Table.TransformColumnTypes(Source, {{"invoice_date", type date}, {"month", type date}, {"quantity", Int64.Type}, {"price", Currency.Type}, {"revenue", Currency.Type}, {"customer_id", Int64.Type}})
				in
				    Typed
